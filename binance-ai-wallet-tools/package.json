    "radar": "node src/radar/radar.mjs",
    "radar:once": "node src/radar/radar.mjs --once",
    "telegram": "node src/telegram/bot.mjs",
    "service": "node scripts/service.mjs",
    "check": "node scripts/check.mjs",
